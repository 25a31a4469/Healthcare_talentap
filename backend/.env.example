# ==============================================================================
# H4 — Backend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy to backend/.env for local backend development:
#   cp backend/.env.example backend/.env
# ==============================================================================

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite Local Database (Points to healthcare.db):
DATABASE_URL=sqlite:///./healthcare.db

# Production Database (PostgreSQL example):
# DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# CORS: Comma-separated list of allowed frontend origins (no wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Clinical Demo Mode & Synthetic Banners
DEMO_MODE=true
SYNTHETIC_DATA_BANNER=true
