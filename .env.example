# ==============================================================================
# H4 — The Medication Safety Second Pair of Eyes
# Environment Configuration Template (.env.example)
# ==============================================================================

# Backend Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000

# Database Configuration (SQLite default; PostgreSQL compatible)
# For SQLite local development:
DATABASE_URL=sqlite:///./healthcare.db
# For PostgreSQL production deployment:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/medication_safety

# Security & CORS (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Synthetic Demo & Data Mode
DEMO_MODE=true
SYNTHETIC_DATA_BANNER=true

# Optional LLM Explanation API (System operates fully offline without LLM keys)
# LLM_API_KEY=
# LLM_PROVIDER=none

# Frontend Environment Configuration (Place in frontend/.env if building separately)
# VITE_API_URL=http://127.0.0.1:8000
