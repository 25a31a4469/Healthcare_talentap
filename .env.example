# ==============================================================================
# H4 — The Medication Safety Second Pair of Eyes
# Root Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this template to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets, private keys, or passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL=sqlite:///./healthcare.db

# Production Deployment (PostgreSQL example):
# DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# ------------------------------------------------------------------------------
# 3. Security & CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# In production, replace with your actual HTTPS domain(s):
# CORS_ORIGINS=https://app.medicationsafety.example.com

# ------------------------------------------------------------------------------
# 4. Clinical Decision-Support & Demo Settings
# ------------------------------------------------------------------------------
DEMO_MODE=true
SYNTHETIC_DATA_BANNER=true

# ------------------------------------------------------------------------------
# 5. Frontend Public Settings (Vite reads only VITE_* variables)
# ------------------------------------------------------------------------------
# In local development, leave empty to route requests through the Vite /api proxy:
VITE_API_BASE_URL=
# In production or decoupled deployment, set to your backend API URL:
# VITE_API_BASE_URL=https://api.medicationsafety.example.com
VITE_APP_TITLE=H4 — The Medication Safety Second Pair of Eyes
