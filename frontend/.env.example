# ==============================================================================
# H4 — Frontend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy to frontend/.env for local frontend development:
#   cp frontend/.env.example frontend/.env
#
# SECURITY NOTICE:
# Only variables prefixed with VITE_ are embedded into the client-side JavaScript bundle.
# NEVER place database credentials, API secrets, or private keys in this file.
# ==============================================================================

# Backend API Base URL
# - In local development: Leave empty to leverage Vite dev server proxy (/api -> http://127.0.0.1:8000)
# - In production: Set to the full public backend URL (e.g., https://api.medicationsafety.example.com)
VITE_API_BASE_URL=

# Application Display Title
VITE_APP_TITLE=H4 — The Medication Safety Second Pair of Eyes
